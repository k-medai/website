---
import Base from '../layouts/Base.astro';
import pubs from '../data/publications.json';

const TYPES = ['International (Journal)', 'International (Conference)', 'Domestic (Journal)', 'Domestic (Conference)', 'Patent'];
const typeLabel: Record<string, string> = {
  'International (Journal)': 'International Journal',
  'International (Conference)': 'International Conference',
  'Domestic (Journal)': 'Domestic Journal',
  'Domestic (Conference)': 'Domestic Conference',
  Patent: 'Patent',
};
const years = [...new Set(pubs.map((p) => p.year))];
const counts = Object.fromEntries(TYPES.map((t) => [t, pubs.filter((p) => p.type === t).length]));
const byYear = years.map((y) => ({
  year: y,
  groups: TYPES.map((t) => ({ type: t, items: pubs.filter((p) => p.year === y && p.type === t) })).filter((g) => g.items.length),
}));
const total = pubs.length;
---
<Base title="Publications" description="부산대 Medical AI Lab 논문과 특허 목록. 연도, 유형, 키워드로 검색">
  <section class="page-head">
    <div class="wrap">
      <h1>Publications</h1>
      <p class="counts">
        {TYPES.map((t) => <span class="cnt"><b class="tnum">{counts[t]}</b> {typeLabel[t]}</span>)}
      </p>
    </div>
  </section>

  <div class="filters" data-filters>
    <div class="wrap filters-in">
      <div class="group" role="group" aria-label="연도">
        <button class="chip on" data-year="all" aria-pressed="true">All years</button>
        {years.map((y) => <button class="chip tnum" data-year={y} aria-pressed="false">{y}</button>)}
      </div>
      <div class="group" role="group" aria-label="유형">
        <button class="chip on" data-type="all" aria-pressed="true">All types</button>
        {TYPES.map((t) => <button class="chip" data-type={t} aria-pressed="false">{typeLabel[t]}</button>)}
      </div>
      <label class="search">
        <span class="eyebrow">Search</span>
        <input id="pub-search" type="search" placeholder="제목, 저자, 학회, 키워드" autocomplete="off" />
      </label>
      <output class="count tnum" data-count aria-live="polite">{total} / {total}</output>
    </div>
  </div>

  <div class="wrap list">
    {byYear.map((y) => (
      <section class="year" data-year-group={y.year}>
        <h2 class="year-h tnum">{y.year}</h2>
        <div class="year-body">
          {y.groups.map((g) => (
            <div class="tgroup" data-type-group>
              <h3 class="eyebrow">{typeLabel[g.type]}</h3>
              <ol class="items">
                {g.items.map((p) => (
                  <li class="item" data-year={p.year} data-type={p.type} data-text={`${p.title} ${p.meta} ${p.award ?? ''}`.toLowerCase()}>
                    <div class="t">
                      <span class="title">{p.title}</span>
                      {p.award && <span class="award">{p.award}</span>}
                    </div>
                    {p.meta && <p class="meta">{p.meta}</p>}
                    {p.links.length > 0 && (
                      <div class="links">{p.links.map((l) => <a href={l.href} target="_blank" rel="noopener">{l.label}</a>)}</div>
                    )}
                  </li>
                ))}
              </ol>
            </div>
          ))}
        </div>
      </section>
    ))}
    <p class="empty" data-empty hidden>조건에 맞는 항목이 없습니다.</p>
  </div>
</Base>

<style>
  .counts { display: flex; flex-wrap: wrap; gap: 6px 28px; margin-top: 24px; font-size: 16px; color: var(--muted); }
  .cnt b { font-weight: 400; font-size: 26px; color: var(--text); margin-right: 6px; }
  .filters { position: sticky; top: 76px; z-index: 20; background: color-mix(in srgb, var(--paper) 92%, transparent); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px); border-bottom: 1px solid var(--rule); }
  .filters-in { display: grid; grid-template-columns: 1fr auto; gap: 8px 24px; padding-block: 12px; align-items: center; }
  .group { display: flex; flex-wrap: wrap; gap: 2px 4px; grid-column: 1 / -1; }
  .chip { font-size: 14px; padding: 5px 10px; border-bottom: 1px solid transparent; color: var(--muted); transition: color 0.2s, border-color 0.2s; }
  .chip:hover { color: var(--text); }
  .chip.on { color: var(--text); border-color: var(--text); }
  .search { display: flex; align-items: center; gap: 12px; grid-column: 1; }
  .search input { font: inherit; font-size: 15px; padding: 8px 0; border: 0; border-bottom: 1px solid var(--rule-2); background: transparent; color: var(--text); min-width: 260px; width: min(420px, 100%); }
  .search input:focus { outline: 0; border-color: var(--text); }
  .count { grid-column: 2; justify-self: end; font-size: 14px; color: var(--muted); letter-spacing: 0.06em; }
  @media (max-width: 920px) { .filters { top: 68px; } }
  @media (max-width: 700px) { .filters { position: static; } .filters-in { grid-template-columns: 1fr; } .count { grid-column: 1; justify-self: start; } .search input { min-width: 0; width: 100%; } }

  .list { padding-block: 10px 80px; }
  .year { display: grid; grid-template-columns: 160px minmax(0, 1fr); gap: 16px 48px; padding-block: 40px; border-bottom: 1px solid var(--rule); }
  .year:last-of-type { border-bottom: 0; }
  .year-h { font-size: clamp(34px, 4vw, 52px); font-weight: 400; letter-spacing: -0.02em; line-height: 1; position: sticky; top: 150px; align-self: start; }
  .year-body { display: grid; gap: 30px; }
  .tgroup h3 { margin-bottom: 8px; }
  .items { list-style: none; margin: 0; padding: 0; display: grid; }
  .item { padding: 16px 0; border-top: 1px solid var(--rule); display: grid; gap: 6px; }
  .t { display: flex; flex-wrap: wrap; gap: 6px 14px; align-items: baseline; }
  .title { font-size: 18px; line-height: 1.45; text-wrap: pretty; }
  .award { font-size: 14px; color: #0e8a94; white-space: nowrap; }
  .meta { margin: 0; font-size: 14.5px; color: var(--muted); line-height: 1.6; }
  .links { display: flex; flex-wrap: wrap; gap: 16px; font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; }
  .empty { padding: 40px 0; color: var(--muted); }
  @media (max-width: 760px) { .year { grid-template-columns: 1fr; gap: 10px; } .year-h { position: static; } }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-filters]');
  if (root) {
    const items = Array.from(document.querySelectorAll<HTMLElement>('.item'));
    const count = document.querySelector<HTMLElement>('[data-count]');
    const empty = document.querySelector<HTMLElement>('[data-empty]');
    const input = document.getElementById('pub-search') as HTMLInputElement | null;
    let year = 'all', type = 'all', q = '';

    const setChip = (attr: 'data-year' | 'data-type', value: string) => {
      root.querySelectorAll<HTMLButtonElement>(`[${attr}]`).forEach((b) => {
        const on = b.getAttribute(attr) === value;
        b.classList.toggle('on', on);
        b.setAttribute('aria-pressed', String(on));
      });
    };
    const apply = () => {
      let shown = 0;
      for (const el of items) {
        const ok = (year === 'all' || el.dataset.year === year) && (type === 'all' || el.dataset.type === type) && (!q || (el.dataset.text ?? '').includes(q));
        el.hidden = !ok; if (ok) shown++;
      }
      document.querySelectorAll<HTMLElement>('[data-type-group]').forEach((g) => { g.hidden = !g.querySelector('.item:not([hidden])'); });
      document.querySelectorAll<HTMLElement>('[data-year-group]').forEach((g) => { g.hidden = !g.querySelector('.item:not([hidden])'); });
      if (count) count.textContent = `${shown} / ${items.length}`;
      if (empty) empty.hidden = shown > 0;
    };
    root.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-year],button[data-type]');
      if (!b) return;
      if (b.dataset.year) { year = b.dataset.year; setChip('data-year', year); }
      if (b.dataset.type) { type = b.dataset.type; setChip('data-type', type); }
      apply();
    });
    input?.addEventListener('input', () => { q = input.value.trim().toLowerCase(); apply(); });
  }
</script>
