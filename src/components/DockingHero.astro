---
/**
 * 단백질–리간드 결합(도킹) 3D 모션 그래픽.
 * RCSB PDB 결정구조(1IEP, 3ERT, 2ITY)의 실제 좌표를 Three.js로 렌더링한다.
 * 리간드가 결합 포켓으로 들어와 결합하고 수소결합이 나타난 뒤 다음 복합체로 넘어간다.
 * WebGL이 없으면 정지 포스터를 보여 준다. (OS의 동작 줄이기 설정은 따르지 않는다: 연구실 요청으로 항상 움직인다. ?still=1은 포스터 캡처용)
 */
---
<div class="dock" data-dock>
  <img class="dock-poster" src="/img/hero-poster.jpg" alt="" aria-hidden="true" decoding="async" fetchpriority="high" data-dock-poster />
  <canvas class="dock-canvas" aria-hidden="true" data-dock-canvas></canvas>
  <div class="dock-shade" aria-hidden="true"></div>
</div>

<style>
  .dock { position: absolute; inset: 0; overflow: hidden; background: radial-gradient(120% 90% at 70% 40%, #14264a 0%, #0b1730 45%, #070f1f 100%); }
  .dock-poster { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 1; transition: opacity 1.2s var(--ease); }
  .dock-poster.hide { opacity: 0; }
  .dock-canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .dock-shade { position: absolute; inset: 0; pointer-events: none; background:
    linear-gradient(90deg, rgba(7, 15, 31, 0.78) 0%, rgba(7, 15, 31, 0.42) 38%, rgba(7, 15, 31, 0) 62%),
    linear-gradient(180deg, rgba(7, 15, 31, 0.35) 0%, rgba(7, 15, 31, 0) 28%, rgba(7, 15, 31, 0) 70%, rgba(7, 15, 31, 0.6) 100%); }
  @media (max-width: 860px) {
    .dock-shade { background: linear-gradient(180deg, rgba(7, 15, 31, 0.55) 0%, rgba(7, 15, 31, 0.25) 40%, rgba(7, 15, 31, 0.7) 100%); }
  }
</style>

<script>
  import * as THREE from 'three';
  import c1 from '../data/complexes/1iep.json';
  import c2 from '../data/complexes/3ert.json';
  import c3 from '../data/complexes/2ity.json';
  import c4 from '../data/complexes/2euf.json';
  import c5 from '../data/complexes/5ds3.json';

  type Atom = [string, number, number, number, number?];
  type Complex = {
    pdb: string;
    ligand: { res: string; atoms: Atom[]; bonds: [number, number][] };
    pocket: { atoms: Atom[]; bonds: [number, number][]; residues: { num: number; res: string }[] };
    hbonds: [number, number, number][];
    backbone: number[][][];
    extent: number;
  };
  const COMPLEXES: { data: Complex; ligand: string; target: string; pdb: string }[] = [
    { data: c1 as Complex, ligand: 'Imatinib', target: 'ABL1 tyrosine kinase', pdb: '1IEP' },
    { data: c2 as Complex, ligand: '4-Hydroxytamoxifen', target: 'Estrogen receptor α', pdb: '3ERT' },
    { data: c3 as Complex, ligand: 'Gefitinib', target: 'EGFR kinase domain', pdb: '2ITY' },
    { data: c4 as Complex, ligand: 'Palbociclib', target: 'CDK6 kinase', pdb: '2EUF' },
    { data: c5 as Complex, ligand: 'Olaparib', target: 'PARP1 catalytic domain', pdb: '5DS3' },
  ];
  /** 복합체마다 다른 연출: 리간드가 들어오는 방향(side: right·up 성분)과 회전축·각도, 카메라 기본 방위각(az), 머무는 시간 차이(hold, 초).
   *  같은 동작을 반복 재생하는 것처럼 보이지 않게 한다. */
  const VARIANTS = [
    { side: [5, 3], axis: [0.3, 1, 0.2], angle: 1.6, az: 0, hold: 0 },
    { side: [-6, 2], axis: [1, 0.2, -0.3], angle: -1.3, az: 0.45, hold: 0.8 },
    { side: [2, -5], axis: [-0.2, 0.6, 1], angle: 2.0, az: -0.4, hold: -0.6 },
    { side: [-4, -3], axis: [0.5, -1, 0.3], angle: 1.2, az: 0.8, hold: 1.2 },
    { side: [6, 1], axis: [0, 0.3, 1], angle: -1.8, az: -0.75, hold: 0.4 },
  ];

  const root = document.querySelector<HTMLElement>('[data-dock]');
  const canvas = document.querySelector<HTMLCanvasElement>('[data-dock-canvas]');
  const poster = document.querySelector<HTMLImageElement>('[data-dock-poster]');
  const params = new URLSearchParams(location.search);
  const still = params.has('still'); // 정지 포즈 (포스터 생성용)
  const startIndex = Number(params.get('i') || 0) % COMPLEXES.length;

  function webglOk(): boolean {
    try { const c = document.createElement('canvas'); return !!(c.getContext('webgl2') || c.getContext('webgl')); } catch { return false; }
  }

  if (root && canvas && webglOk()) {
    start();
  }

  function start() {
    const ATOM_COLOR: Record<string, number> = { C: 0xdfe5ee, N: 0x3d9ff5, O: 0xff6b6b, S: 0xf2c94c, F: 0x7ee0c8, Cl: 0x68d391, Br: 0xc08a5a, P: 0xff9f43 };
    const POCKET_COLOR: Record<string, number> = { C: 0x7f8fa8, N: 0x4f8fd0, O: 0xd67878, S: 0xc9ad55 };
    const ATOM_R: Record<string, number> = { C: 0.42, N: 0.44, O: 0.44, S: 0.52, F: 0.4, Cl: 0.52, Br: 0.56, P: 0.52 };
    const FOG = 0x0b1730;

    const renderer = new THREE.WebGLRenderer({ canvas: canvas!, antialias: true, alpha: true, powerPreference: 'high-performance' });
    renderer.setClearColor(0x000000, 0);
    renderer.outputColorSpace = THREE.SRGBColorSpace;
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.05;

    const scene = new THREE.Scene();
    scene.fog = new THREE.Fog(FOG, 30, 95);
    const camera = new THREE.PerspectiveCamera(30, 1, 0.5, 400);

    scene.add(new THREE.HemisphereLight(0xdbe8ff, 0x0b1730, 0.9));
    const key = new THREE.DirectionalLight(0xffffff, 1.7); key.position.set(28, 40, 48); scene.add(key);
    const rim = new THREE.DirectionalLight(0x12b5c4, 1.4); rim.position.set(-40, -12, -36); scene.add(rim);
    const fill = new THREE.DirectionalLight(0x2495f2, 0.5); fill.position.set(-20, 30, 20); scene.add(fill);
    scene.add(new THREE.AmbientLight(0xffffff, 0.22));

    // halo sprite texture
    const haloTex = (() => {
      const s = 128; const c = document.createElement('canvas'); c.width = c.height = s;
      const g = c.getContext('2d')!; const grd = g.createRadialGradient(s / 2, s / 2, 0, s / 2, s / 2, s / 2);
      grd.addColorStop(0, 'rgba(255,255,255,1)'); grd.addColorStop(0.35, 'rgba(255,255,255,0.35)'); grd.addColorStop(1, 'rgba(255,255,255,0)');
      g.fillStyle = grd; g.fillRect(0, 0, s, s);
      const t = new THREE.CanvasTexture(c); t.colorSpace = THREE.SRGBColorSpace; return t;
    })();

    const sphereGeo = new THREE.SphereGeometry(1, 28, 20);
    const sphereGeoLo = new THREE.SphereGeometry(1, 14, 10);
    const cylGeo = new THREE.CylinderGeometry(1, 1, 1, 14, 1, true);
    const cylGeoLo = new THREE.CylinderGeometry(1, 1, 1, 8, 1, true);
    const up = new THREE.Vector3(0, 1, 0);
    const dummy = new THREE.Object3D();
    const tmpA = new THREE.Vector3(), tmpB = new THREE.Vector3(), tmpD = new THREE.Vector3();

    type Fadeable = { mat: THREE.Material & { opacity: number }; base: number };
    const world = new THREE.Group(); scene.add(world);
    let fades: Fadeable[] = [];
    let ligandGroup = new THREE.Group();
    let hbGroup = new THREE.Group();
    let pulse: THREE.Sprite | null = null;
    let pocketMat: THREE.MeshStandardMaterial | null = null;
    let haloMat: THREE.SpriteMaterial | null = null;
    let ligandSpheres: THREE.InstancedMesh | null = null;
    let basis = { fwd: new THREE.Vector3(0, 0, 1), right: new THREE.Vector3(1, 0, 0), up: new THREE.Vector3(0, 1, 0) };
    let startPos = new THREE.Vector3();
    let startQuat = new THREE.Quaternion();
    let tEnd = 12.6, azOff = 0;
    let nHb = 0;

    const lowPower = Math.min(window.innerWidth, window.innerHeight) < 760;

    function cylinderAt(mesh: THREE.InstancedMesh, k: number, a: THREE.Vector3, b: THREE.Vector3, r: number) {
      tmpD.subVectors(b, a); const len = tmpD.length();
      dummy.position.addVectors(a, b).multiplyScalar(0.5);
      dummy.quaternion.setFromUnitVectors(up, tmpD.normalize());
      dummy.scale.set(r, len, r); dummy.updateMatrix(); mesh.setMatrixAt(k, dummy.matrix);
    }
    function sphereAt(mesh: THREE.InstancedMesh, k: number, p: THREE.Vector3, r: number) {
      dummy.position.copy(p); dummy.quaternion.identity(); dummy.scale.setScalar(r); dummy.updateMatrix(); mesh.setMatrixAt(k, dummy.matrix);
    }
    function v(a: Atom) { return new THREE.Vector3(a[1], a[2], a[3]); }

    function clearWorld() {
      world.traverse((o) => { const m = o as THREE.Mesh; if (m.geometry && m.geometry !== sphereGeo && m.geometry !== sphereGeoLo && m.geometry !== cylGeo && m.geometry !== cylGeoLo) m.geometry.dispose(); });
      for (const f of fades) f.mat.dispose();
      world.clear(); fades = []; pulse = null; pocketMat = null; haloMat = null; ligandSpheres = null;
    }

    function build(idx: number) {
      clearWorld();
      const C = COMPLEXES[idx].data;
      const sg = lowPower ? sphereGeoLo : sphereGeo, cg = lowPower ? cylGeoLo : cylGeo;

      // --- protein backbone tube
      const tubeMat = new THREE.MeshPhysicalMaterial({ color: 0x3a5a9a, roughness: 0.55, metalness: 0.05, transparent: true, opacity: 0.0, clearcoat: 0.3, side: THREE.DoubleSide });
      fades.push({ mat: tubeMat, base: 0.55 });
      const centroid = new THREE.Vector3(); let nC = 0;
      for (const seg of C.backbone) {
        const pts = seg.map((p) => new THREE.Vector3(p[0], p[1], p[2]));
        for (const p of pts) { centroid.add(p); nC++; }
        const curve = new THREE.CatmullRomCurve3(pts, false, 'centripetal', 0.5);
        const geo = new THREE.TubeGeometry(curve, Math.min(900, pts.length * (lowPower ? 2 : 4)), 0.34, lowPower ? 6 : 10, false);
        world.add(new THREE.Mesh(geo, tubeMat));
      }
      centroid.divideScalar(Math.max(1, nC));

      // --- pocket residues: thin sticks + small spheres
      pocketMat = new THREE.MeshStandardMaterial({ color: 0xffffff, roughness: 0.5, metalness: 0.05, transparent: true, opacity: 0, emissive: 0x12b5c4, emissiveIntensity: 0 });
      fades.push({ mat: pocketMat, base: 0.95 });
      const pa = C.pocket.atoms.map(v);
      const pSph = new THREE.InstancedMesh(sg, pocketMat, pa.length);
      C.pocket.atoms.forEach((a, i) => { sphereAt(pSph, i, pa[i], 0.15); pSph.setColorAt(i, new THREE.Color(POCKET_COLOR[a[0]] ?? 0x7f8fa8)); });
      world.add(pSph);
      const pBond = new THREE.InstancedMesh(cg, pocketMat, C.pocket.bonds.length * 2);
      C.pocket.bonds.forEach(([i, j], k) => {
        tmpA.addVectors(pa[i], pa[j]).multiplyScalar(0.5);
        cylinderAt(pBond, 2 * k, pa[i], tmpA.clone(), 0.11); pBond.setColorAt(2 * k, new THREE.Color(POCKET_COLOR[C.pocket.atoms[i][0]] ?? 0x7f8fa8));
        cylinderAt(pBond, 2 * k + 1, tmpA.clone(), pa[j], 0.11); pBond.setColorAt(2 * k + 1, new THREE.Color(POCKET_COLOR[C.pocket.atoms[j][0]] ?? 0x7f8fa8));
      });
      world.add(pBond);

      // --- ligand: ball and stick (in its own group so it can fly in)
      ligandGroup = new THREE.Group(); world.add(ligandGroup);
      const ligMat = new THREE.MeshPhysicalMaterial({ color: 0xffffff, roughness: 0.3, metalness: 0.0, clearcoat: 0.7, clearcoatRoughness: 0.25, transparent: true, opacity: 0 });
      fades.push({ mat: ligMat, base: 1 });
      const la = C.ligand.atoms.map(v);
      ligandSpheres = new THREE.InstancedMesh(sg, ligMat, la.length);
      C.ligand.atoms.forEach((a, i) => { sphereAt(ligandSpheres!, i, la[i], ATOM_R[a[0]] ?? 0.42); ligandSpheres!.setColorAt(i, new THREE.Color(ATOM_COLOR[a[0]] ?? 0xdfe5ee)); });
      ligandGroup.add(ligandSpheres);
      const lBond = new THREE.InstancedMesh(cg, ligMat, C.ligand.bonds.length * 2);
      C.ligand.bonds.forEach(([i, j], k) => {
        tmpA.addVectors(la[i], la[j]).multiplyScalar(0.5);
        cylinderAt(lBond, 2 * k, la[i], tmpA.clone(), 0.17); lBond.setColorAt(2 * k, new THREE.Color(ATOM_COLOR[C.ligand.atoms[i][0]] ?? 0xdfe5ee));
        cylinderAt(lBond, 2 * k + 1, tmpA.clone(), la[j], 0.17); lBond.setColorAt(2 * k + 1, new THREE.Color(ATOM_COLOR[C.ligand.atoms[j][0]] ?? 0xdfe5ee));
      });
      ligandGroup.add(lBond);
      // halos behind ligand atoms (additive)
      haloMat = new THREE.SpriteMaterial({ map: haloTex, color: 0x9fd8ff, transparent: true, opacity: 0, blending: THREE.AdditiveBlending, depthWrite: false });
      fades.push({ mat: haloMat, base: 0.16 });
      for (let i = 0; i < la.length; i++) { const s = new THREE.Sprite(haloMat); s.position.copy(la[i]); s.scale.setScalar(2.4); ligandGroup.add(s); }
      // pulse sprite at ligand centre
      const pulseMat = new THREE.SpriteMaterial({ map: haloTex, color: 0x12b5c4, transparent: true, opacity: 0, blending: THREE.AdditiveBlending, depthWrite: false });
      pulse = new THREE.Sprite(pulseMat); pulse.scale.setScalar(6); world.add(pulse);

      // --- hydrogen bonds: dashed segments (small cylinders)
      hbGroup = new THREE.Group(); world.add(hbGroup);
      const hbMat = new THREE.MeshBasicMaterial({ color: 0x5fe0ea, transparent: true, opacity: 0 });
      fades.push({ mat: hbMat, base: 0 }); // 수소결합은 도킹 후에만 켠다 (hbOn으로 제어)
      let dashes = 0; const segs: [THREE.Vector3, THREE.Vector3][] = [];
      for (const [li, pi] of C.hbonds) {
        const a = la[li], b = pa[pi]; const n = Math.max(3, Math.round(a.distanceTo(b) / 0.42));
        for (let s = 0; s < n; s++) { const t0 = (s + 0.15) / n, t1 = (s + 0.6) / n; segs.push([a.clone().lerp(b, t0), a.clone().lerp(b, t1)]); dashes++; }
      }
      const hbMesh = new THREE.InstancedMesh(cg, hbMat, Math.max(1, dashes));
      segs.forEach(([a, b], k) => cylinderAt(hbMesh, k, a, b, 0.075));
      hbMesh.count = dashes; hbGroup.add(hbMesh);
      (hbGroup as any).mat = hbMat;
      nHb = C.hbonds.length;

      // --- camera basis: look from outside the pocket into it
      const fwd = centroid.clone().negate().normalize(); // protein centre → ligand (origin)
      if (!isFinite(fwd.x) || fwd.length() < 0.5) fwd.set(0, 0, 1);
      const upRef = Math.abs(fwd.y) > 0.85 ? new THREE.Vector3(1, 0, 0) : new THREE.Vector3(0, 1, 0);
      const right = new THREE.Vector3().crossVectors(upRef, fwd).normalize();
      const upv = new THREE.Vector3().crossVectors(fwd, right).normalize();
      basis = { fwd, right, up: upv };
      const vr = VARIANTS[idx % VARIANTS.length];
      startPos = fwd.clone().multiplyScalar(17).add(right.clone().multiplyScalar(vr.side[0])).add(upv.clone().multiplyScalar(vr.side[1]));
      startQuat = new THREE.Quaternion().setFromAxisAngle(new THREE.Vector3(vr.axis[0], vr.axis[1], vr.axis[2]).normalize(), vr.angle);
      tEnd = 12.6 + vr.hold; azOff = vr.az;

    }

    // --- sizing
    let w = 1, h = 1;
    function resize() {
      const r = root!.getBoundingClientRect();
      w = Math.max(1, Math.round(r.width)); h = Math.max(1, Math.round(r.height));
      renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, lowPower ? 1.5 : 2));
      renderer.setSize(w, h, false);
      camera.aspect = w / h; camera.updateProjectionMatrix();
      // 넓은 화면에서는 장면을 오른쪽으로 밀어 왼쪽 텍스트와 겹치지 않게
      const shift = w > 860 ? -w * 0.19 : 0;
      camera.setViewOffset(w, h, shift, w > 860 ? 0 : -h * 0.06, w, h);
    }
    new ResizeObserver(resize).observe(root!);
    resize();

    // --- pointer parallax
    let px = 0, py = 0, tx = 0, ty = 0;
    window.addEventListener('pointermove', (e) => { if (e.pointerType === 'touch') return; tx = (e.clientX / window.innerWidth - 0.5) * 2; ty = (e.clientY / window.innerHeight - 0.5) * 2; }, { passive: true });

    // --- timeline
    const T_APPROACH0 = 0.5, T_APPROACH1 = 4.6, T_HOLD_END = 11.6, T_END = 12.6;
    const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
    const smooth = (t: number) => t * t * (3 - 2 * t);
    const clamp01 = (x: number) => Math.min(1, Math.max(0, x));
    let idx = startIndex; build(idx);
    let t0 = performance.now() / 1000; let elapsed = 0;
    let visible = true, hidden = false, firstFrame = false, clock = 0; // clock: 실제로 렌더한 시간만 쌓는다(전환 중 쉰 뒤에도 카메라가 튀지 않게)
    const io = new IntersectionObserver((es) => { visible = es[0]?.isIntersecting ?? true; }, { threshold: 0.02 });
    io.observe(root!);
    document.addEventListener('visibilitychange', () => { hidden = document.hidden; });
    let lastNow = performance.now() / 1000;

    const q = new THREE.Quaternion();
    const camPos = new THREE.Vector3();

    function frame(now: number) {
      requestAnimationFrame(frame);
      const sec = now / 1000; const dt = Math.min(0.1, sec - lastNow); lastNow = sec;
      if (!visible || hidden || document.documentElement.dataset.scrolling) return; // 화면 전환 중에는 렌더를 쉬어 스크롤이 매끄럽게
      if (still) elapsed = 7.5; else elapsed += dt;
      clock += dt;

      if (elapsed >= tEnd) { idx = (idx + 1) % COMPLEXES.length; build(idx); elapsed = 0; }
      const t = elapsed;
      // fade in/out
      const fade = Math.min(smooth(clamp01(t / 0.9)), smooth(clamp01((tEnd - t) / 0.9)));
      for (const f of fades) f.mat.opacity = f.base * fade;
      // ligand approach
      const s = ease(clamp01((t - T_APPROACH0) / (T_APPROACH1 - T_APPROACH0)));
      ligandGroup.position.copy(startPos).multiplyScalar(1 - s);
      q.copy(startQuat).slerp(new THREE.Quaternion(), s); ligandGroup.quaternion.copy(q);
      const bound = s >= 1;
      // hydrogen bonds grow in after binding
      const hbT = clamp01((t - T_APPROACH1) / 0.7);
      const hbMat = (hbGroup as any).mat as THREE.MeshBasicMaterial | undefined;
      if (hbMat) hbMat.opacity = (0.55 + 0.35 * Math.sin(t * 2.2)) * smooth(hbT) * fade;
      // pocket flash and pulse ring on docking
      if (pocketMat) pocketMat.emissiveIntensity = 0.9 * Math.exp(-Math.max(0, t - T_APPROACH1) * 1.6) * (t > T_APPROACH1 ? 1 : 0);
      if (pulse) { const pt = Math.max(0, t - T_APPROACH1); pulse.scale.setScalar(6 + pt * 11); (pulse.material as THREE.SpriteMaterial).opacity = 0.45 * Math.exp(-pt * 1.4) * (t > T_APPROACH1 ? 1 : 0) * fade; }
      if (haloMat) haloMat.opacity = (0.12 + 0.08 * (bound ? 0.5 + 0.5 * Math.sin(t * 1.5) : 0)) * fade;
      // camera: 마우스가 없어도 스스로 움직인다 — 포켓 주위를 ±45°쯤 크게 돌며(두 주기를 섞어 멈추는 순간이 없게),
      // 위아래로도 기울고, 거리도 숨 쉬듯 변한다. 포인터가 있으면 시차가 더해진다.
      px += (tx - px) * Math.min(1, dt * 2.5); py += (ty - py) * Math.min(1, dt * 2.5);
      const az = (still ? 0.25 : Math.sin(clock * 0.29) * 0.55 + Math.sin(clock * 0.13) * 0.25) + azOff + px * 0.22;
      const el = 0.22 + (still ? 0 : Math.sin(clock * 0.19) * 0.12 + Math.sin(clock * 0.07) * 0.05) + py * -0.14;
      const dist = 44 + (bound ? 0 : 4 * (1 - s)) + (still ? 0 : Math.sin(clock * 0.23) * 2.5);
      camPos.copy(basis.fwd).multiplyScalar(Math.cos(az) * Math.cos(el)).addScaledVector(basis.right, Math.sin(az) * Math.cos(el)).addScaledVector(basis.up, Math.sin(el)).multiplyScalar(dist);
      camera.position.copy(camPos); camera.up.copy(basis.up); camera.lookAt(0, 0, 0);
      renderer.render(scene, camera);
      if (!firstFrame) { firstFrame = true; poster?.classList.add('hide'); root!.classList.add('live'); }
    }
    requestAnimationFrame(frame);
  }
</script>
